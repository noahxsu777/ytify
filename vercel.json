{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "outputDirectory": "dist",
  "functions": {
    "api/stream.ts": { "maxDuration": 60 },
    "api/iv.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
